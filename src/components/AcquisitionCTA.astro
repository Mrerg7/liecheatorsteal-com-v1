---
import { ACQUISITION_MAILTO, SITE } from '../config/site';
---

<section id="acquire" class="relative z-10 bg-zinc-950 border-y border-zinc-800">
  <div class="max-w-4xl mx-auto px-6 py-20 text-center">
    <div class="max-w-2xl mx-auto">
      <div class="inline-block px-4 py-1 bg-red-950/50 border border-red-900 rounded-full text-sm font-medium tracking-wider text-red-500 mb-6">
        PREMIUM .COM AVAILABLE
      </div>

      <h2 class="heading-font text-4xl md:text-5xl font-semibold tracking-tighter mb-6">
        Acquire liecheatorsteal.com
      </h2>

      <p class="text-xl text-zinc-400 max-w-md mx-auto mb-10">
        A rare, memorable domain with built-in narrative power. Serious buyers may inquire for pricing, transfer logistics, and escrow options.
      </p>

      <a
        href={ACQUISITION_MAILTO}
        class="inline-flex items-center justify-center gap-x-3 px-10 py-4 bg-red-600 hover:bg-red-700 text-white font-semibold text-lg rounded-3xl transition-all active:scale-[0.985] shadow-lg shadow-red-950/40"
      >
        <span>Inquire About Acquisition</span>
        <i class="fa-solid fa-envelope"></i>
      </a>

      <p class="mt-8 text-sm text-zinc-500">
        Contact: <a href={`mailto:${SITE.email}`} class="text-red-500 hover:text-red-400 transition-colors">{SITE.email}</a>
      </p>
    </div>
  </div>
</section>
