---
import type { CollectionEntry } from 'astro:content';
import type { RenderedContent } from 'astro:content';

type RenderedRecord = CollectionEntry<'records'> & RenderedContent;

interface Props {
  id: string;
  title: string;
  subtitle: string;
  icon: string;
  iconColor: string;
  accentColor: string;
  categoryLabel: string;
  categoryTagline: string;
  records: RenderedRecord[];
}

const { id, title, subtitle, icon, iconColor, accentColor, categoryLabel, categoryTagline, records } = Astro.props;
---

<section id={id} class="max-w-6xl mx-auto px-6 pb-20 scroll-mt-20">
  <div class="flex items-end justify-between mb-8">
    <div>
      <div class="flex items-center gap-x-3">
        <i class={`${icon} text-4xl ${iconColor} trifecta-icon`}></i>
        <h2 class="heading-font text-4xl sm:text-5xl font-semibold tracking-tighter">{title}</h2>
      </div>
      <p class={`${accentColor} mt-1 text-lg`}>{subtitle}</p>
    </div>
    <div class="hidden md:block text-right">
      <div class="text-xs font-mono text-zinc-500">{categoryLabel}</div>
      <div class={`${accentColor} text-sm font-semibold`}>{categoryTagline}</div>
    </div>
  </div>

  <div class="grid md:grid-cols-2 gap-5">
    {
      records.map((record) => {
        const { Content } = record;
        return (
          <div class={`sin-card bg-zinc-900 rounded-3xl p-7 ${record.data.fullWidth ? 'md:col-span-2' : ''}`}>
            <div class="flex items-center justify-between mb-4">
              <div class={`sin-year ${accentColor} text-sm font-mono tracking-widest`}>{record.data.year}</div>
            </div>
            <h3 class="text-2xl font-semibold tracking-tight mb-3">{record.data.title}</h3>
            <div class="text-zinc-400 leading-relaxed">
              <Content />
            </div>
            {record.data.footnote && (
              <div class="mt-4 pt-4 border-t border-zinc-800 text-xs text-zinc-500">{record.data.footnote}</div>
            )}
          </div>
        );
      })
    }
  </div>
</section>
