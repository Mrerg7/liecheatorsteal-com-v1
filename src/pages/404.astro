---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found — liecheatorsteal.com"
  description="The page you are looking for does not exist."
  noindex={true}
>
  <div class="min-h-screen flex flex-col items-center justify-center text-center px-4 demonic-bg">
    <div class="max-w-lg">
      <h1 class="text-6xl font-bold text-red-500 mb-4">404</h1>
      <h2 class="text-3xl font-bold text-white mb-4">Page Not Found</h2>
      <p class="text-gray-400 text-lg mb-8">
        The page you are looking for doesn't exist. It may have been moved, deleted, or was never here — much like accountability in Washington.
      </p>
      <a
        href="/"
        class="inline-block bg-red-600 hover:bg-red-700 text-white font-bold py-3 px-8 rounded-lg transition-colors duration-200"
      >
        Return Home
      </a>
    </div>
  </div>
</BaseLayout>
